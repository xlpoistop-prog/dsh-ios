<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Node binary this port builds.

  dynamic-codesigning is the one that matters for JIT: without it iOS refuses to
  make pages executable, which is what the whole dual-mapping design in
  03-fix-wx-alias.py depends on. The rest match what the existing jailbreak Node
  packages ship, so the binary behaves like the one this repository already
  installs.

  This is separate from scripts/entitlements.plist, which signs the native
  modules (node-pty, the image codec) and does not need any of the JIT set.
-->
<plist version="1.0">
<dict>
  <key>platform-application</key>
  <true/>
  <key>com.apple.private.security.no-sandbox</key>
  <true/>
  <key>com.apple.private.security.no-container</key>
  <true/>
  <key>get-task-allow</key>
  <true/>
  <key>com.apple.private.cs.debugger</key>
  <true/>
  <key>dynamic-codesigning</key>
  <true/>
  <key>com.apple.private.skip-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
